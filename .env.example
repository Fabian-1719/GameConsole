# -------------------------------------------------------------
# Configuración de GameConsole
# -------------------------------------------------------------

# Puerto expuesto para la consola web (Nginx) y la aplicación
PORT=3000

# URLs internas entre contenedores (Docker network)
GAMESTATS_URL=http://gamestats-go:8080
ANALYTICS_URL=http://gamestats-scala:8081
PROLOG_URL=http://prolog-ai:5000

# Concurrencia y Outbox de EventPublisher
PUBLISHER_WORKERS=4
OUTBOX_PATH=/data/outbox.ndjson

# Puertos locales para depuración de GameStats (opcional)
GAMESTATS_GO_PORT=8080
GAMESTATS_SCALA_PORT=8081

# -------------------------------------------------------------
# Imágenes en GitHub Container Registry (GHCR)
# -------------------------------------------------------------
GAMESTATS_GO_IMAGE=ghcr.io/fabian-1719/gamestats-go:latest
GAMESTATS_SCALA_IMAGE=ghcr.io/fabian-1719/gamestats-scala:latest
CONSOLE_IMAGE=ghcr.io/fabian-1719/gameconsole-server:latest
CONSOLE_WEB_IMAGE=ghcr.io/fabian-1719/gameconsole-web:latest
PROLOG_IMAGE=ghcr.io/fabian-1719/gameconsole-prolog:latest
